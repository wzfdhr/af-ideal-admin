{
  "name": "AF-Ideal-Admin",
  "private": true,
  "version": "0.0.1-alpha",
  "scripts": {
    "dev": "vite serve --mode development",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
    "build:prd": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "lint": "npx eslint . --ext .ts,.js,.tsx,.jsx,.vue --fix",
    "lint:check": "npx eslint . --ext .ts,.js,.tsx,.jsx,.vue",
    "lint-staged": "npx lint-staged",
    "prepare": "husky install",
    "serve": "vite preview"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@antv/x6": "^2.1.1",
    "@antv/x6-plugin-clipboard": "^2.1.3",
    "@antv/x6-plugin-dnd": "^2.0.3",
    "@antv/x6-plugin-history": "^2.1.2",
    "@antv/x6-plugin-keyboard": "^2.1.4",
    "@antv/x6-plugin-selection": "^2.1.5",
    "@antv/x6-plugin-snapline": "^2.1.6",
    "@antv/x6-plugin-stencil": "^2.0.2",
    "@antv/x6-plugin-transform": "^2.1.4",
    "@arco-design/web-vue": "^2.40.0",
    "@salmon-ui/icons": "^1.1.8",
    "@types/crypto-js": "^4.2.2",
    "@vueuse/core": "^9.1.0",
    "axios": "^0.27.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.4",
    "echarts": "^5.4.0",
    "lodash": "^4.17.21",
    "mitt": "^3.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.0.17",
    "query-string": "^7.1.1",
    "vue": "^3.2.37",
    "vue-echarts": "^6.2.3",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.1.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/lodash": "^4.14.186",
    "@types/mockjs": "^1.0.6",
    "@types/node": "^18.6.4",
    "@types/nprogress": "^0.2.0",
    "@types/sortablejs": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^5.32.0",
    "@typescript-eslint/parser": "^5.32.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vitejs/plugin-vue-jsx": "^3.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.8",
    "eslint": "^8.21.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.4.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.3.0",
    "husky": "^8.0.2",
    "jsdom": "^22.1.0",
    "lint-staged": "^13.1.0",
    "mockjs": "^1.1.0",
    "postcss": "^8.4.14",
    "prettier": "^2.8.0",
    "sass": "^1.54.3",
    "stylelint": "^14.9.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^26.0.0",
    "stylelint-order": "^5.0.0",
    "tailwindcss": "^3.1.7",
    "ts-node": "^10.9.1",
    "typescript": "<4.9.0",
    "unplugin-vue-components": "^0.22.0",
    "vite": "^4.0.3",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.0.13"
  }
}
