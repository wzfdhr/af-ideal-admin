ARG NODE_IMAGE=mcr.microsoft.com/playwright:v1.61.1-jammy@sha256:7b86926fff94374389e8e1f4fdc5c76d050d4a06a7886bb537bf412b20e2b71e
FROM ${NODE_IMAGE} AS build
WORKDIR /app
ENV HUSKY=0
COPY package.json package-lock.json ./
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/workflow-core/package.json ./packages/workflow-core/package.json
COPY services/reference-api/package.json ./services/reference-api/package.json
RUN npm ci --no-audit --fetch-retries=1 --fetch-timeout=30000
COPY . .
RUN npm run build:all

FROM build AS api
ARG R1_SOURCE_COMMIT=unverified
LABEL org.opencontainers.image.revision=${R1_SOURCE_COMMIT}
ENV NODE_ENV=production HOST=0.0.0.0 PORT=10888 APP_MODE=pilot
CMD ["node", "services/reference-api/dist/index.js"]

FROM ${NODE_IMAGE} AS web
ARG R1_SOURCE_COMMIT=unverified
LABEL org.opencontainers.image.revision=${R1_SOURCE_COMMIT}
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nginx=1.18.0-6ubuntu14.21 gettext-base && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/compose/nginx.conf.template /etc/nginx/r1-default.conf.template
ENV API_PROXY_PASS=http://api:10888
EXPOSE 80
CMD ["sh", "-c", "envsubst '${API_PROXY_PASS}' < /etc/nginx/r1-default.conf.template > /etc/nginx/sites-enabled/default && nginx -g 'daemon off;'"]
